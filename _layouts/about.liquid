---
layout: default
---
<div class="lab-home">
  <header class="lab-hero">
    <div class="lab-hero-copy">
      <p class="eyebrow">University of Bergamo</p>
      <h1><span class="discipline">Formal Methods</span> and <span class="discipline discipline-software">Software Engineering</span> Laboratory</h1>
      <div class="hero-actions">
        <a class="lab-text-link" href="{{ '/research/' | relative_url }}">Our research</a>
        <a class="lab-text-link" href="{{ '/people/' | relative_url }}">Meet the group</a>
      </div>
    </div>
    <figure class="lab-identity">
      {% include research_intersection.liquid %}
      <figcaption>FOSELAB</figcaption>
    </figure>
  </header>
  <article class="lab-introduction">
    <div><h2>About the lab</h2></div>
    <div class="lab-introduction-copy">{{ content }}</div>
  </article>
  <section class="lab-explore" aria-labelledby="explore-title">
    <div class="section-heading"><h2 id="explore-title">Explore FOSELAB</h2></div>
    <div class="explore-grid">
      {% assign sections = site.pages | where: 'nav', true | sort: 'nav_order' %}
      {% for section in sections %}
        <a class="explore-card" href="{{ section.url | relative_url }}">
          <h3>{{ section.title }}</h3>
          <p>{{ section.description }}</p>
        </a>
      {% endfor %}
    </div>
  </section>
  <aside class="lab-contact"><div><h2>Contact</h2><p>Interested in our research? We'd love to hear from you!</p></div><a class="lab-text-link" href="mailto:{{ site.email }}">{{ site.email }}</a></aside>
</div>
